{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "Every payload: `{\"schemaVersion\": 1, \"kind\": \"...\", \"data\": {...}}`.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/LabelsOut"
    },
    "kind": {
      "description": "\"search\" | \"thread\" | \"threads\" | \"labels\" | \"people\" | \"accounts\" | \"attachmentText\" | \"ask\" | \"ruleMatch\" | \"error\"",
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "data"
  ],
  "$defs": {
    "LabelOut": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "\"system\" | \"user\"",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "unreadCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "accountId",
        "id",
        "name",
        "kind"
      ]
    },
    "LabelsOut": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LabelOut"
          }
        },
        "scope": {
          "$ref": "#/$defs/ScopeOut"
        }
      },
      "required": [
        "scope",
        "labels"
      ]
    },
    "ScopeOut": {
      "description": "What a request was limited to.",
      "type": "object",
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "accountIds": {
          "description": "The profile's member accounts, when a profile was given.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
