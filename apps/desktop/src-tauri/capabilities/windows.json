{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows",
  "description": "Conversation and compose windows (src/windows.rs): reading, triaging and answering one conversation, or writing one message. No accounts, sign-in, sync control, Settings pages, rules editing, notifications setup or diagnostics; those stay in the main window. Same CSP and sandboxed message iframe as the main window.",
  "windows": [
    "thread-*",
    "compose-*"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "allow-log-client-event",
    "allow-list-accounts",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-labels",
    "allow-get-thread",
    "allow-load-remote-images",
    "allow-modify-threads",
    "allow-snooze-threads",
    "allow-unsnooze-threads",
    "allow-list-snoozes",
    "allow-reply-later",
    "allow-triage-counts",
    "allow-search",
    "allow-open-external",
    "allow-open-path",
    "allow-native-paste",
    "allow-copy-text",
    "allow-spell-check",
    "allow-learn-spelling",
    "allow-look-up",
    "allow-save-attachment",
    "allow-preview-attachment",
    "allow-get-message-details",
    "allow-get-message-source",
    "allow-fetch-message-image",
    "allow-save-message-image",
    "allow-save-message-images",
    "allow-prepare-image-drag",
    "allow-prepare-attachment-drag",
    "allow-start-file-drag",
    "allow-save-image-as",
    "allow-save-attachment-as",
    "allow-reveal-saved-path",
    "allow-unsubscribe-check",
    "allow-unsubscribe",
    "allow-save-rule",
    "allow-run-rule",
    "allow-person-summary",
    "allow-person-meetings",
    "allow-avatar-lookup",
    "allow-account-photo",
    "allow-me-photo",
    "allow-get-event",
    "allow-event-invite",
    "allow-respond-to-invite",
    "allow-summary-availability",
    "allow-cached-summary",
    "allow-summarize-thread",
    "allow-cancel-summary",
    "allow-prewarm-summarizer",
    "allow-sanitize-compose-html",
    "allow-save-draft",
    "allow-quote-sources",
    "allow-delete-draft",
    "allow-get-draft",
    "allow-send-message",
    "allow-schedule-send",
    "allow-cancel-scheduled-send",
    "allow-list-scheduled-sends",
    "allow-set-reminder",
    "allow-write-with-ai",
    "allow-cancel-write",
    "allow-prewarm-writer",
    "allow-suggest-replies",
    "allow-read-snippet-file",
    "allow-set-menu-context",
    "allow-open-window",
    "allow-take-window-seed"
  ]
}
